#!/usr/bin/env bash
# inventory — what's on this Mac, and what would be lost if you only re-cloned and re-installed.
#
#   bin/inventory                 print the report
#   bin/inventory --out FILE      also write it to FILE (default: inventory-report.md)
#
# Read-only. Nothing is copied, changed or uploaded, and no secret values are printed.
set -uo pipefail

OUT="${2:-inventory-report.md}"
[ "${1:-}" = "--out" ] || OUT="inventory-report.md"

exec > >(tee "$OUT")

h() { printf '\n## %s\n\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

echo "# Inventory — $(scutil --get ComputerName 2>/dev/null), $(date +%F)"
echo
echo "macOS $(sw_vers -productVersion) · $(sysctl -n machdep.cpu.brand_string 2>/dev/null) · user \`$(whoami)\`"
echo
echo "Generated by mac-migration-kit. Read-only report; no secrets included."

h "Disk and home folders"
df -h / 2>/dev/null | tail -1 | awk '{print "- Startup disk: " $4 " free of " $2}'
for dir in Code Developer Projects Documents Desktop Downloads Pictures Movies Music; do
  [ -d "$HOME/$dir" ] && printf -- "- ~/%s: %s\n" "$dir" "$(du -sh "$HOME/$dir" 2>/dev/null | cut -f1)"
done

h "Shell"
echo "- Login shell: $SHELL"
for f in .zshrc .zprofile .zshenv .bashrc .bash_profile .config/fish/config.fish; do
  [ -f "$HOME/$f" ] && printf -- "- ~/%s (%s lines)%s\n" "$f" "$(wc -l < "$HOME/$f" | xargs)" \
    "$( [ -L "$HOME/$f" ] && echo ' → symlink, probably already in a dotfiles repo')"
done
grep -l -E '^[[:space:]]*export [A-Z_]*(KEY|TOKEN|SECRET|PASSWORD)' "$HOME"/.zshrc "$HOME"/.zprofile "$HOME"/.bashrc 2>/dev/null \
  | sed 's|^|- ⚠︎ secrets exported in: |'
[ -d "$HOME/.oh-my-zsh" ] || [ -d "$HOME/.oh-my-zsh.bak" ] && echo "- Oh My Zsh installed"

h "Dotfiles repo"
for d in "$HOME/.dotfiles" "$HOME/dotfiles" "$HOME/.config/dotfiles"; do
  if [ -d "$d/.git" ]; then
    echo "- $d → $(git -C "$d" remote get-url origin 2>/dev/null || echo 'no remote'), $(git -C "$d" status --porcelain | wc -l | xargs) uncommitted"
  fi
done
[ -d "$HOME/.dotfiles" ] || echo "- none found (see docs/03-dotfiles.md)"

h "Packages"
if have brew; then
  echo "- Homebrew $(brew --version | head -1 | cut -d' ' -f2): $(brew leaves 2>/dev/null | wc -l | xargs) top-level formulae, $(brew list --cask 2>/dev/null | wc -l | xargs) casks"
  echo "- Taps: $(brew tap | tr '\n' ' ')"
else
  echo "- Homebrew not installed"
fi
have mas && echo "- App Store apps (mas): $(mas list 2>/dev/null | wc -l | xargs)"
echo "- /Applications: $(ls /Applications 2>/dev/null | grep -c '\.app$') apps"
if have brew; then
  echo "- Apps not installed through Homebrew (check these by hand):"
  comm -23 <(ls /Applications | sed 's/\.app$//' | tr '[:upper:]' '[:lower:]' | tr -d ' ' | sort) \
           <(brew list --cask 2>/dev/null | tr -d '-' | sort) 2>/dev/null | head -25 | sed 's/^/    - /'
fi

h "Languages and toolchains"
for tool in node npm pnpm yarn bun deno php composer python3 pipx uv ruby rbenv rustc cargo go java docker kubectl terraform; do
  have "$tool" && printf -- "- %s: %s\n" "$tool" "$($tool --version 2>&1 | head -1 | cut -c1-60)"
done
[ -d "$HOME/.nvm/versions/node" ] && echo "- nvm versions: $(ls "$HOME/.nvm/versions/node" | tr '\n' ' ')"
have pipx && echo "- pipx apps: $(pipx list --short 2>/dev/null | awk '{print $1}' | tr '\n' ' ')"
have npm && echo "- global npm: $(npm ls -g --depth=0 2>/dev/null | tail -n +2 | awk '{print $2}' | tr '\n' ' ')"

h "Local web environment"
for cli in herd valet; do
  have $cli && echo "- $cli present: capture parked folders, links, per-site PHP versions, HTTPS and php.ini overrides"
done
have docker && docker ps -a --format '{{.Names}}' >/dev/null 2>&1 && \
  echo "- Docker: $(docker ps -q 2>/dev/null | wc -l | xargs) running, $(docker ps -aq 2>/dev/null | wc -l | xargs) total containers, $(docker volume ls -q 2>/dev/null | wc -l | xargs) volumes"
have brew && brew services list 2>/dev/null | tail -n +2 | awk '$2=="started"{print "- service running: " $1}'

h "Code and unpushed work"
CODE_DIR="${CODE_DIR:-$HOME/Code}"
if [ -d "$CODE_DIR" ]; then
  echo "Run \`bin/repo-report\` for the full table. Summary:"
  total=0; risky=0
  for dir in "$CODE_DIR"/*/; do
    [ -d "$dir/.git" ] || continue
    total=$((total+1))
    dirty=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | xargs)
    remote=$(git -C "$dir" remote | head -1)
    ahead=$(git -C "$dir" log --branches --not --remotes --oneline 2>/dev/null | wc -l | xargs)
    stash=$(git -C "$dir" stash list 2>/dev/null | wc -l | xargs)
    { [ -z "$remote" ] || [ "$dirty" != 0 ] || [ "$ahead" != 0 ] || [ "$stash" != 0 ]; } && risky=$((risky+1))
  done
  echo "- $total git repos in $CODE_DIR, $risky with work that exists only here"
  echo "- $(find "$CODE_DIR" -maxdepth 2 -name '.env' -not -path '*/node_modules/*' 2>/dev/null | wc -l | xargs) .env files (not in git)"
else
  echo "- no $CODE_DIR (set CODE_DIR=... and re-run)"
fi

h "SSH and credentials (names only)"
echo "- Keys in ~/.ssh: $(ls "$HOME"/.ssh/*.pub 2>/dev/null | wc -l | xargs) public keys — run \`bin/ssh-audit\` to see which are still used"
[ -f "$HOME/.ssh/config" ] && echo "- ~/.ssh/config: $(grep -c '^Host ' "$HOME/.ssh/config") Host entries"
for f in .aws/config .aws/credentials .kube/config .npmrc .composer/auth.json .config/composer/auth.json .docker/config.json .netrc; do
  [ -f "$HOME/$f" ] && echo "- ~/$f present$( [ "${f##*/}" = "credentials" ] || [ "${f##*/}" = "auth.json" ] || [ "${f##*/}" = ".netrc" ] && echo ' ⚠︎ contains secrets')"
done

h "AI tooling"
for tool in claude codex gemini copilot cursor-agent amp opencode; do
  have "$tool" && echo "- CLI installed: $tool"
done
for d in .claude .codex .gemini .cursor .config/github-copilot .agents; do
  [ -d "$HOME/$d" ] && echo "- config: ~/$d ($(du -sh "$HOME/$d" 2>/dev/null | cut -f1))"
done
ls -d "$HOME"/.claude-* 2>/dev/null | sed 's|.*/|- extra profile: ~/|'
for f in .claude.json .codex/config.toml .gemini/settings.json .cursor/mcp.json; do
  [ -f "$HOME/$f" ] && echo "- MCP/config file: ~/$f"
done

h "Apps whose data needs attention"
check_app() { [ -d "/Applications/$1.app" ] && printf -- "- %s — %s\n" "$1" "$2"; }
check_app "TablePlus"        "export connections WITH passwords (Keychain)"
check_app "Sequel Ace"       "export connections (Keychain)"
check_app "DataGrip"         "settings sync; DB passwords in Keychain"
check_app "Docker"           "volumes don't move by themselves"
check_app "Obsidian"         "copy the vault folder"
check_app "Raycast"          "Settings → Advanced → Export"
check_app "Alfred"           "export preferences"
check_app "CleanShot X"      "defaults export + licence is device-bound"
check_app "Rectangle"        "defaults export"
check_app "iTerm"            "point it at a settings folder in your dotfiles"
check_app "Arc"              "profiles don't sync; note spaces per profile"
check_app "Google Chrome"    "profiles per person; sessions don't move"
for app in /Applications/*.app; do
  case "$(basename "$app")" in
    PhpStorm.app|IntelliJ*|WebStorm.app|PyCharm*|GoLand.app|RubyMine.app|DataGrip.app|Rider.app)
      echo "- $(basename "$app" .app) — settings sync: choose GET on the new Mac; DB passwords in Keychain" ;;
  esac
done

h "Next steps"
cat <<'TXT'
1. `bin/repo-report` — projects holding work that exists only here
2. `bin/ssh-audit` — which keys are still used
3. `bin/migrate` — build your plan
4. Read `docs/01-principles.md`
TXT
